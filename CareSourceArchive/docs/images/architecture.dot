digraph CareSource_Delta_Archive {
    graph [
        rankdir=TB
        splines=ortho
        nodesep=1.0
        ranksep=1.8
        pad=1.0
        fontsize=15
        fontname=Helvetica
        bgcolor=white
        dpi=180
        label="CareSource — Delta Table Archive System Architecture"
        labelloc=b
        labeljust=c
        fontcolor="#222222"
    ]
    node [fontname=Helvetica fontsize=11]
    edge [fontname=Helvetica fontsize=10 fontcolor="#555555" color="#666666"]

    # ── Row 0: Bootstrap ──────────────────────────────────────────────────────
    param [
        shape=parallelogram
        label="config_table\n(job parameter)"
        style=filled fillcolor="#fff9e6" color="#ccaa00"
        width=2.2 height=0.7
    ]

    # ── Row 1: Global Settings ────────────────────────────────────────────────
    global_settings [
        shape=rectangle style="rounded,filled"
        fillcolor="#dceefb" color="#4a90d9"
        label="⚙  Global Settings\n─────────────────────\nBootstrap entry point (1 row)\naudit location · concurrency\nsecret scope · archive path prefix\nschema_templates_table ptr\ntable_configs_table ptr"
        width=3.5 height=2.2
    ]

    # ── Row 2: Schema Templates + RunContext ──────────────────────────────────
    schema_templates [
        shape=rectangle style="rounded,filled"
        fillcolor="#dceefb" color="#4a90d9"
        label="▲  Schema Templates\n─────────────────────\n1 row per schema\ndate column patterns\nretention defaults\nsize thresholds"
        width=2.8 height=1.8
    ]
    run_ctx [
        shape=rectangle style="rounded,filled"
        fillcolor="#fde8c8" color="#e67e22"
        label="⬡  RunContext\n─────────────────────\nsettings · secrets\njob ctx · run_id\nBuilt once per job run"
        width=2.8 height=1.8
    ]

    # ── Row 3: Scanner + Table Configs ────────────────────────────────────────
    scanner [
        shape=rectangle style="rounded,filled"
        fillcolor="#fde8c8" color="#e67e22"
        label="⬡  Schema Scanner\n─────────────────────\nauto-discover tables\ndate-column matching\nambiguity detection\nsize checks"
        width=2.8 height=1.9
    ]
    table_configs [
        shape=rectangle style="rounded,filled"
        fillcolor="#dceefb" color="#4a90d9"
        label="▲  Table Configs\n─────────────────────\n1 row per table\narchive settings\ndate col · retention\nexclusion conditions"
        width=2.8 height=1.9
    ]

    # ── Row 4: Scanner outputs ────────────────────────────────────────────────
    staging [
        shape=rectangle style="rounded,filled"
        fillcolor="#dceefb" color="#4a90d9"
        label="▲  Table Configs Staging\n─────────────────────\nScanner output\nMERGE reconciliation"
        width=2.8 height=1.4
    ]
    scan_log [
        shape=rectangle style="rounded,filled"
        fillcolor="#dceefb" color="#4a90d9"
        label="▲  Scanner Log\n─────────────────────\nPer-table detail\nambiguity flags"
        width=2.8 height=1.4
    ]

    # ── Row 5: Archive Engine ─────────────────────────────────────────────────
    archive_engine [
        shape=rectangle style="rounded,filled"
        fillcolor="#d5f5e3" color="#27ae60"
        label="⬡  Archive Engine   (archiver.py)\n──────────────────────────────────────\nEvaluate retention per year\nApply exclusion conditions (SQL)\nCheck resume / concurrency state\nWrite new Delta Ext Table (CREATE)\nAppend newly-eligible records (APPEND)\nVerify record counts post-write\nOptionally delete from source"
        width=4.5 height=2.5
    ]

    # ── Row 6: External Volume ────────────────────────────────────────────────
    year_a [
        shape=cylinder style=filled fillcolor="#ede7f6" color="#8e44ad"
        label="year_2020\nΔ External Table\n/Volumes/..."
        width=2.0 height=1.5
    ]
    year_b [
        shape=cylinder style=filled fillcolor="#ede7f6" color="#8e44ad"
        label="year_2021\nΔ External Table\n/Volumes/..."
        width=2.0 height=1.5
    ]
    year_c [
        shape=cylinder style=filled fillcolor="#ede7f6" color="#8e44ad"
        label="year_N\nΔ External Table\n+ _metadata.json"
        width=2.0 height=1.5
    ]

    # ── Audit (side) ──────────────────────────────────────────────────────────
    audit [
        shape=rectangle style="rounded,filled"
        fillcolor="#dceefb" color="#4a90d9"
        label="▲  Audit Log\n─────────────────────\nStatus state machine\nResume detection\nConcurrency guard\nAll archive + rehydrate actions"
        width=2.8 height=2.0
    ]

    # ── Row 7: Rehydration Engine ─────────────────────────────────────────────
    rehydrate [
        shape=rectangle style="rounded,filled"
        fillcolor="#d0f0ea" color="#16a085"
        label="⬡  Rehydration Engine   (rehydrator.py)\n────────────────────────────────────────────\nCreate target schema if needed\nFor each requested year → CREATE EXTERNAL TABLE\n(zero-copy — points to archive folder)\nCreate unified view: live table + all archived years\nLog to audit"
        width=5.0 height=2.2
    ]

    # ── Row 8: Target ─────────────────────────────────────────────────────────
    uc [
        shape=rectangle style="rounded,filled"
        fillcolor="#fce4e4" color="#c0392b"
        label="Unity Catalog Target\n─────────────────────\nExternal Tables (per year)\n+ Unified View\n(live + all archived years)"
        width=3.2 height=1.8
    ]

    # ── Rank assignments ──────────────────────────────────────────────────────
    { rank=same; schema_templates; run_ctx }
    { rank=same; scanner; table_configs }
    { rank=same; staging; scan_log }
    { rank=same; year_a; year_b; year_c }

    # ── Edges ─────────────────────────────────────────────────────────────────
    # Bootstrap
    param -> global_settings [label="  param: config_table" style=dashed color="#999999"]

    # Config discovery (dashed = pointer references)
    global_settings -> schema_templates [label="  schema_templates_table" style=dashed color="#4a90d9"]
    global_settings -> table_configs    [label="  table_configs_table"    style=dashed color="#4a90d9"]
    global_settings -> run_ctx          [label="  loaded into"             color="#e67e22"]

    # Scanner pipeline
    schema_templates -> scanner [label="  read" color="#e67e22"]
    scanner -> scan_log         [label="  per-table detail" color="#888888"]
    scanner -> staging          [label="  discovered tables" color="#e67e22"]
    staging -> table_configs    [label="  MERGE →" color="#4a90d9" style=bold]

    # Archive pipeline
    run_ctx       -> archive_engine [label="  context" color="#27ae60"]
    table_configs -> archive_engine [label="  primary input" color="#27ae60" style=bold]

    archive_engine -> year_a [label="  write/append" color="#8e44ad"]
    archive_engine -> year_b [color="#8e44ad"]
    archive_engine -> year_c [color="#8e44ad"]
    archive_engine -> audit  [label="  log action" color="#888888"]

    # Rehydration pipeline
    year_a    -> rehydrate [label="  zero-copy" color="#16a085"]
    year_b    -> rehydrate [color="#16a085"]
    year_c    -> rehydrate [color="#16a085"]
    rehydrate -> uc        [label="  creates" color="#c0392b" style=bold]
    rehydrate -> audit     [label="  log action" color="#888888"]
}

digraph ModuleHierarchy {
    graph [
        rankdir=TB
        fontname="Segoe UI, Roboto, sans-serif"
        fontsize=13
        bgcolor="white"
        compound=true
        pad=0.4
        nodesep=0.5
        ranksep=0.9
    ];
    node [
        fontname="Segoe UI, Roboto, sans-serif"
        fontsize=12
        shape=box
        style="filled,rounded"
        fontcolor="white"
        penwidth=1.5
        margin="0.22,0.15"
    ];
    edge [
        fontname="Segoe UI, Roboto, sans-serif"
        fontsize=9
        color="#4a6fa5"
    ];

    /* ── Application Layer ── */
    subgraph cluster_app {
        label="Application Layer"
        style="rounded,filled"
        fillcolor="#f8f9fa"
        color="#94a3b8"
        fontsize=13
        fontcolor="#1a1a2e"
        penwidth=1.5

        ARCHIVE   [label=<ArchiveEngine<BR/><FONT POINT-SIZE="9"><I>class</I></FONT>>   fillcolor="#8c5a2a" color="#5c3a1a"]
        REHYDRATE [label=<RehydrationEngine<BR/><FONT POINT-SIZE="9"><I>class</I></FONT>> fillcolor="#1a7a5c" color="#0d5c3f"]
        AL        [label=<AuditLogger<BR/><FONT POINT-SIZE="9"><I>class</I></FONT>>       fillcolor="#b07d3a" color="#8a5f20"]
        SCAN      [label=<scanner<BR/><FONT POINT-SIZE="9"><I>module</I></FONT>>          fillcolor="#2d6a4f" color="#1b4332"]
        CFG       [label=<config<BR/><FONT POINT-SIZE="9"><I>module</I></FONT>>            fillcolor="#1a3a5c" color="#0d253f"]

        ARCHIVE   -> AL  [label="uses"]
        REHYDRATE -> AL  [label="uses"]
        ARCHIVE   -> CFG [label="uses"]
        SCAN      -> CFG [label="uses"]
    }

    /* ── Foundation Layer ── */
    subgraph cluster_foundation {
        label="Foundation Layer  (used by all modules above)"
        style="rounded,filled"
        fillcolor="#f8f9fa"
        color="#94a3b8"
        fontsize=13
        fontcolor="#1a1a2e"
        penwidth=1.5

        RC    [label=<RunContext<BR/><FONT POINT-SIZE="9"><I>@dataclass</I></FONT>>   fillcolor="#5b3e96" color="#3d2670"]
        UTILS [label=<utils<BR/><FONT POINT-SIZE="9"><I>pure functions</I></FONT>>    fillcolor="#5b3e96" color="#3d2670"]
        COND  [label=<conditions<BR/><FONT POINT-SIZE="9"><I>SQL builders</I></FONT>> fillcolor="#7a2a4a" color="#5c1a3a"]
    }

    /* ── Exception Hierarchy ── */
    subgraph cluster_exceptions {
        label="Exception Hierarchy"
        style="rounded,filled"
        fillcolor="#f8f9fa"
        color="#94a3b8"
        fontsize=13
        fontcolor="#1a1a2e"
        penwidth=1.5

        AE  [label="ArchiveError"            fillcolor="#8c2a2a" color="#6b1d1d"]
        ACE [label="ArchiveConfigError"       fillcolor="#8c2a2a" color="#6b1d1d"]
        AOE [label="ArchiveOperationError"    fillcolor="#8c2a2a" color="#6b1d1d"]
        AVE [label="ArchiveVerificationError" fillcolor="#8c2a2a" color="#6b1d1d"]

        AE -> ACE [color="#6b1d1d" arrowhead=empty]
        AE -> AOE [color="#6b1d1d" arrowhead=empty]
        AE -> AVE [color="#6b1d1d" arrowhead=empty]
    }

    /* ── Single arrow from App Layer to Foundation Layer ── */
    AL -> UTILS [lhead=cluster_foundation ltail=cluster_app label="depends on" style=bold penwidth=2]
}

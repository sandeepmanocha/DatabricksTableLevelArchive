digraph TDDFramework {
    graph [
        rankdir=TB
        fontname="Segoe UI, Roboto, sans-serif"
        fontsize=13
        bgcolor="white"
        pad=0.4
        nodesep=0.5
        ranksep=0.7
        compound=true
    ];
    node [
        fontname="Segoe UI, Roboto, sans-serif"
        fontsize=11
        shape=box
        style="filled,rounded"
        fontcolor="white"
        penwidth=1.5
        margin="0.2,0.12"
    ];
    edge [
        fontname="Segoe UI, Roboto, sans-serif"
        fontsize=9
        color="#4a6fa5"
    ];

    /* ── Test Framework ── */
    subgraph cluster_framework {
        label="Test Framework — pytest + unittest.mock"
        style="rounded,filled"
        fillcolor="white"
        color="#94a3b8"
        fontsize=12
        fontcolor="#1a1a2e"
        penwidth=1.5

        CONFTEST [label=<conftest.py<BR/><FONT POINT-SIZE="9"><I>shared fixtures</I></FONT><BR/><FONT POINT-SIZE="9">mock_spark · mock_run_context · mock_audit</FONT>> fillcolor="#2d6a4f" color="#1b4332"]

        subgraph cluster_unit {
            label="Unit Tests — 1:1 with src/ modules"
            style="rounded,filled"
            fillcolor="white"
            color="#94a3b8"
            fontsize=11
            fontcolor="#1a1a2e"
            penwidth=1

            TA  [label="test_archiver"    fillcolor="#1a3a5c" color="#0d253f"]
            TAU [label="test_audit"       fillcolor="#1a3a5c" color="#0d253f"]
            TC  [label="test_config"      fillcolor="#1a3a5c" color="#0d253f"]
            TCO [label="test_conditions"  fillcolor="#1a3a5c" color="#0d253f"]
            TE  [label="test_exceptions"  fillcolor="#1a3a5c" color="#0d253f"]
            TR  [label="test_rehydrator"  fillcolor="#1a3a5c" color="#0d253f"]
            TS  [label="test_scanner"     fillcolor="#1a3a5c" color="#0d253f"]
            TU  [label="test_utils"       fillcolor="#1a3a5c" color="#0d253f"]
        }

        subgraph cluster_integ {
            label="Integration Tests"
            style="rounded,filled"
            fillcolor="white"
            color="#94a3b8"
            fontsize=11
            fontcolor="#1a1a2e"
            penwidth=1

            GEN [label=<generate_test_data<BR/><FONT POINT-SIZE="9"><I>interactive</I></FONT>> fillcolor="#8c5a2a" color="#5c3a1a"]
        }

        CONFTEST -> TA  [style=dashed arrowhead=open]
        CONFTEST -> TAU [style=dashed arrowhead=open]
        CONFTEST -> TC  [style=dashed arrowhead=open]
        CONFTEST -> TCO [style=dashed arrowhead=open]
        CONFTEST -> TE  [style=dashed arrowhead=open]
        CONFTEST -> TR  [style=dashed arrowhead=open]
        CONFTEST -> TS  [style=dashed arrowhead=open]
        CONFTEST -> TU  [style=dashed arrowhead=open]
    }

    /* ── TDD Pattern ── */
    subgraph cluster_pattern {
        label="TDD Pattern"
        style="rounded,filled"
        fillcolor="white"
        color="#94a3b8"
        fontsize=12
        fontcolor="#1a1a2e"
        penwidth=1.5

        RED     [label=<RED<BR/><FONT POINT-SIZE="9">Write failing test<BR/>Define expected behavior</FONT>> fillcolor="#8c2a2a" color="#6b1d1d"]
        GREEN   [label=<GREEN<BR/><FONT POINT-SIZE="9">Implement code<BR/>Make test pass</FONT>> fillcolor="#2d6a4f" color="#1b4332"]
        REFACTOR [label=<REFACTOR<BR/><FONT POINT-SIZE="9">Clean up<BR/>Keep tests passing</FONT>> fillcolor="#1a3a5c" color="#0d253f"]

        RED -> GREEN -> REFACTOR -> RED
    }

    /* ── Mock Strategy ── */
    subgraph cluster_mock {
        label="Mock Strategy"
        style="rounded,filled"
        fillcolor="white"
        color="#94a3b8"
        fontsize=12
        fontcolor="#1a1a2e"
        penwidth=1.5

        MS [label=<mock_spark<BR/><FONT POINT-SIZE="9">MagicMock for SparkSession<BR/>.sql().collect() chains</FONT>> fillcolor="#5b3e96" color="#3d2670"]
        MR [label=<mock_run_context<BR/><FONT POINT-SIZE="9">RunContext dataclass<BR/>with test settings</FONT>> fillcolor="#5b3e96" color="#3d2670"]
        MA [label=<mock_audit<BR/><FONT POINT-SIZE="9">MagicMock for AuditLogger<BR/>verify log calls</FONT>> fillcolor="#5b3e96" color="#3d2670"]
    }
}

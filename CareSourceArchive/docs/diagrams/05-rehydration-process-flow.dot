digraph rehydration_process_flow {
    rankdir=TB;
    graph [
        fontname="Helvetica"
        fontsize=10
        bgcolor="#ffffff"
        fontcolor=black
    ];
    node [fontname="Helvetica", fontsize=9, fontcolor=black, color="#6f6f6f"];
    edge [fontname="Helvetica", fontsize=8, fontcolor=black, color="#555555"];

    START [label="Rehydrate Request\nwith runtime params", shape=ellipse, style=filled, fillcolor="#D2D9D5", fontcolor=black];
    SETUP [label="Create target schema\nif needed", shape=box, style="rounded,filled", fillcolor="#E5E8EC"];
    LOOP [label="For each requested year", shape=box, style="rounded,filled", fillcolor="#E5E8EC"];
    CHECK [label="Archive\nexists?", shape=diamond, style=filled, fillcolor="#CCD4CF", fontcolor=black];
    SKIP [label="Skip year", shape=box, style="rounded,filled", fillcolor="#E4E1E6"];
    CREATE [label="Create external table\npointing to archive — zero copy", shape=box, style="rounded,filled", fillcolor="#DDE6DF"];
    MOREYRS [label="More\nyears?", shape=diamond, style=filled, fillcolor="#CCD4CF", fontcolor=black];
    VIEW [label="Create unified view\nmain + archived years", shape=box, style="rounded,filled", fillcolor="#D8DFE2"];
    LOG [label="Log to audit", shape=box, style="rounded,filled", fillcolor="#DDD8D3"];
    DONE [label="Done", shape=ellipse, style=filled, fillcolor="#D2D9D5", fontcolor=black];

    START -> SETUP -> LOOP -> CHECK;
    CHECK -> SKIP [label="No"];
    CHECK -> CREATE [label="Yes"];
    CREATE -> MOREYRS;
    SKIP -> MOREYRS;
    MOREYRS -> LOOP [label="Yes"];
    MOREYRS -> VIEW [label="No"];
    VIEW -> LOG -> DONE;
}

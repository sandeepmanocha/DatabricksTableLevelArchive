digraph bootstrap_flow {
    rankdir=LR;
    graph [
        fontname="Helvetica"
        fontsize=10
        bgcolor="#ffffff"
        fontcolor=black
    ];
    node [
        fontname="Helvetica"
        fontsize=9
        shape=box
        style="rounded,filled"
        fontcolor=black
        color="#6f6f6f"
    ];
    edge [fontname="Helvetica", fontsize=8, fontcolor=black, color="#555555"];

    PARAM [fillcolor="#E2E7ED", label="Job parameter:\nconfig_table"];
    GS [fillcolor="#D8DEE5", label="Read global_settings\n(1 row)"];
    PTRS [fillcolor="#D0D6DD", label="Extract pointers:\nschema_templates_table\ntable_configs_table"];
    ST [fillcolor="#E4E8ED", label="Read schema_templates\n(scanner path)"];
    TC [fillcolor="#E4E8ED", label="Read table_configs\n(archive path)"];
    RC [fillcolor="#C8D4CA", label="Build RunContext\nfrom settings row"];

    PARAM -> GS;
    GS -> PTRS;
    PTRS -> ST;
    PTRS -> TC;
    GS -> RC;
}

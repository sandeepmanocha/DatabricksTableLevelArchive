digraph cicd_pipeline {
    rankdir=LR;
    graph [
        fontname="Helvetica"
        fontsize=10
        bgcolor="#ffffff"
        fontcolor=black
    ];
    node [
        fontname="Helvetica"
        fontsize=9
        shape=box
        style="rounded,filled"
        fontcolor=black
        color="#6f6f6f"
    ];
    edge [fontname="Helvetica", fontsize=8, fontcolor=black, color="#555555"];

    subgraph cluster_pr {
        label="Stage 1: PR Validation";
        labelloc=t;
        fontsize=10;
        fontcolor=black;
        style=rounded;
        fillcolor="#F0EEEA";
        color="#a8a8a8";
        SYNC [fillcolor="#E5E8EC", label="uv sync"];
        UNIT [fillcolor="#E2E6EB", label="uv run pytest tests/unit/"];
        BVAL [fillcolor="#DDE2E8", label="databricks bundle\nvalidate -t dev"];
        SYNC -> UNIT -> BVAL;
    }

    subgraph cluster_deploy {
        label="Stage 2: Deploy Dev";
        labelloc=t;
        fontsize=10;
        fontcolor=black;
        style=rounded;
        fillcolor="#EFEDE8";
        color="#a8a8a8";
        BDEPLOY [fillcolor="#E0E6E2", label="databricks bundle\ndeploy -t dev"];
        INTTEST [fillcolor="#E4E6E8", label="Integration test job\n(optional)"];
        BDEPLOY -> INTTEST [style=dashed, color="#777777"];
    }

    subgraph cluster_promote {
        label="Stage 3: Promote (M2M OAuth SP)";
        labelloc=t;
        fontsize=10;
        fontcolor=black;
        style=rounded;
        fillcolor="#EEF0ED";
        color="#a8a8a8";
        ENV [fillcolor="#D8DEE3", label="Set DATABRICKS_CLIENT_ID\n+ CLIENT_SECRET\nfrom CI secrets"];
        QAD [fillcolor="#CED5DB", label="bundle deploy -t qa"];
        GATE [fillcolor="#E2DED8", label="Manual approval"];
        PRODD [fillcolor="#C8D2CC", label="bundle deploy -t prod"];
        ENV -> QAD -> GATE -> PRODD;
    }

    BVAL -> BDEPLOY [label="merge to main"];
    BDEPLOY -> ENV [label="release tag /\nmanual trigger"];
}

digraph data_flow_e2e {
    rankdir=LR;
    graph [
        fontname="Helvetica"
        fontsize=10
        bgcolor="#ffffff"
        fontcolor=black
    ];
    node [
        fontname="Helvetica"
        fontsize=9
        shape=box
        style="rounded,filled"
        fontcolor=black
        color="#6f6f6f"
    ];
    edge [fontname="Helvetica", fontsize=8, fontcolor=black, color="#555555"];

    subgraph cluster_active {
        label="Active Data";
        fontcolor=black;
        style=rounded;
        fillcolor="#F0EEEA";
        color="#a8a8a8";
        SRC [fillcolor="#E2E7ED", label="Source Table\nAll current data"];
    }

    subgraph cluster_archive {
        label="External Volume Archive Storage";
        fontcolor=black;
        style=rounded;
        fillcolor="#EFEDE8";
        color="#a8a8a8";
        Y20 [fillcolor="#E4DFD6", label="year_2020/\nDelta External + metadata.json"];
        Y21 [fillcolor="#E4DFD6", label="year_2021/\nDelta External + metadata.json"];
    }

    subgraph cluster_rehydrated {
        label="Rehydrated — on demand";
        fontcolor=black;
        style=rounded;
        fillcolor="#EEF0ED";
        color="#a8a8a8";
        EXT [fillcolor="#D6DFD8", label="External Tables\nZero-copy pointers"];
        VIEW [fillcolor="#D0D8E0", label="Unified View\nCurrent + Historical"];
    }

    SRC -> Y20 [label="Archive old\nrecords"];
    SRC -> Y21 [label="Archive old\nrecords"];
    Y20 -> EXT [label="Rehydrate\nzero-copy"];
    Y21 -> EXT [label="Rehydrate\nzero-copy"];
    EXT -> VIEW;
    SRC -> VIEW;
}
